mutate(
s_sum_endring = s_sum_post - s_sum_pre,
repmax_endring = repmax_post - repmax_pre
)
# Beregne endringer
merged_data <- merged_data %>%
mutate(
s_sum_endring = s_sum_post - s_sum_pre,
repmax_endring = repmax_post - repmax_pre
)
# Finne gjennomsnittlig endring per gruppe
resultater <- merged_data %>%
group_by(gruppe) %>%
summarise(
s_sum_pre_mean = mean(s_sum_pre, na.rm = TRUE),
s_sum_post_mean = mean(s_sum_post, na.rm = TRUE),
s_sum_endring_mean = mean(s_sum_endring, na.rm = TRUE),
repmax_pre_mean = mean(repmax_pre, na.rm = TRUE),
repmax_post_mean = mean(repmax_post, na.rm = TRUE),
repmax_endring_mean = mean(repmax_endring, na.rm = TRUE)
)
# Beregne endringer
merged_data <- merged_data %>%
mutate(
s_sum_endring = s_sum_post - s_sum_pre,
repmax_endring = repmax_post - repmax_pre
)
# Vise resultatene
print(resultater)
