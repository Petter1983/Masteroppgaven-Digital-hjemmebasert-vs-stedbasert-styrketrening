mutate(alder = recode(alder, "unge voksne" = "18-44", "middelalder"="45-59", "eldre voksne" = "60-74", "gamle eldre" ="75-89", "eldste eldre" = "90+"))%>%
print()
berg_pre <- komplett_datainnsamling%>%
select(deltaker,gruppe, tid, s_sum)%>%
filter(tid=="pre")%>%
group_by(tid, gruppe)%>%
drop_na()%>%
print()
